rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('ADMIN') || 
             (isAuthenticated() && request.auth.token.email == 'sriramv2116.sse@saveetha.com');
    }

    function isDepartmentAdmin(deptId) {
      return hasRole('DEPARTMENT_ADMIN') && 
             (getUserData().departmentId == deptId || getUserData().departmentId == 'ALL');
    }

    function isOfficer(deptId) {
      return (hasRole('OFFICER') || hasRole('SUPERVISOR')) && 
             (getUserData().departmentId == deptId || getUserData().departmentId == 'ALL');
    }

    function isGovernmentUser() {
      return isAdmin() || 
             hasRole('DEPARTMENT_ADMIN') || 
             hasRole('SUPERVISOR') || 
             hasRole('OFFICER') || 
             hasRole('ANALYST');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isGovernmentUser());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // CITIZENS Collection
    match /citizens/{citizenId} {
      allow read: if isAuthenticated() && (isOwner(citizenId) || isGovernmentUser());
      allow create: if isAuthenticated() && (isOwner(citizenId) || isGovernmentUser());
      allow update: if isAuthenticated() && (isOwner(citizenId) || isGovernmentUser());
      allow delete: if isAdmin();
    }

    // DEPARTMENTS Collection
    match /departments/{departmentId} {
      allow read: if true; // Public directory for intake routing
      allow write: if isAdmin();
    }

    // OFFICERS Collection
    match /officers/{officerId} {
      allow read: if isAuthenticated() && isGovernmentUser();
      allow write: if isAdmin() || isDepartmentAdmin(resource.data.departmentId);
    }

    // COMPLAINTS Collection
    match /complaints/{complaintId} {
      // Citizens can read their own reports; Government users can read based on department or admin status
      allow read: if isAuthenticated() && (
        resource.data.citizenId == request.auth.uid ||
        isAdmin() ||
        (isGovernmentUser() && (getUserData().departmentId == 'ALL' || getUserData().departmentId == resource.data.departmentId))
      );

      // Authenticated citizens can create complaints
      allow create: if isAuthenticated() && (
        request.resource.data.citizenId == request.auth.uid ||
        isGovernmentUser()
      );

      // Updates: Citizen can submit evidence/verification; Officer can update resolution/status; Admin can do anything
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.citizenId == request.auth.uid) ||
        (isGovernmentUser() && (getUserData().departmentId == 'ALL' || getUserData().departmentId == resource.data.departmentId))
      );

      allow delete: if isAdmin();
    }

    // EVIDENCE Collection
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // AI REVIEWS Collection
    match /aiReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create, update: if isGovernmentUser() || isAdmin();
      allow delete: if isAdmin();
    }

    // ESCALATIONS Collection
    match /escalations/{escalationId} {
      allow read: if isAuthenticated() && isGovernmentUser();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ISSUE CLUSTERS Collection
    match /issueClusters/{clusterId} {
      allow read: if true; // Public risk heatmap feeds
      allow write: if isGovernmentUser();
    }

    // TRIGGERS Collection
    match /triggers/{triggerId} {
      allow read: if isAuthenticated() && isGovernmentUser();
      allow write: if isAuthenticated() && isGovernmentUser();
    }

    // AUDIT LOGS Collection
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isGovernmentUser();
      allow create: if isAuthenticated(); // Appends audit trails
      allow update, delete: if false; // Immutable audit log
    }

    // NOTIFICATIONS Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isGovernmentUser());
      allow write: if isAuthenticated();
    }

    // SETTINGS & ANALYTICS Collection
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read: if isAuthenticated() && isGovernmentUser();
      allow write: if isGovernmentUser();
    }
  }
}
